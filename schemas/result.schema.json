{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:audio-notes:result:1.0",
  "title": "Audio Notes Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "title", "language", "scenes", "source", "overview", "topics", "decisions", "actions", "chapters", "quotes", "analysis", "uncertainties", "clean_segments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["draft", "partial", "complete"]},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "scenes": {"type": "array", "minItems": 1, "items": {"enum": ["meeting", "interview", "customer", "recruitment", "learning", "personal", "general"]}},
    "source": {"$ref": "#/$defs/source"},
    "overview": {"type": "array", "items": {"$ref": "#/$defs/textItem"}},
    "topics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "source_ids", "points"], "properties": {"title": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/refs"}, "points": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["text", "source_ids", "kind"], "properties": {"text": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/refs"}, "kind": {"enum": ["statement", "opinion", "proposal", "decision", "action", "uncertain"]}}}}}}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/textItem"}},
    "actions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task", "owner", "due", "dependency", "source_ids"], "properties": {"task": {"type": "string", "minLength": 1}, "owner": {"type": ["string", "null"]}, "due": {"type": ["string", "null"]}, "dependency": {"type": ["string", "null"]}, "source_ids": {"$ref": "#/$defs/refs"}}}},
    "chapters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["title", "text", "start", "source_ids"], "properties": {"title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "start": {"type": ["number", "null"], "minimum": 0}, "source_ids": {"$ref": "#/$defs/refs"}}}},
    "quotes": {"type": "array", "items": {"$ref": "#/$defs/textItem"}},
    "analysis": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation", "interpretation", "recommendation", "limitations", "source_ids"], "properties": {"observation": {"type": "string", "minLength": 1}, "interpretation": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}, "limitations": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/refs"}}}},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/textItem"}},
    "clean_segments": {"type": "array", "items": {"$ref": "#/$defs/textItem"}}
  },
  "$defs": {
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "textItem": {"type": "object", "additionalProperties": false, "required": ["text", "source_ids"], "properties": {"text": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/refs"}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}, "reason": {"type": "string"}}},
    "segment": {"type": "object", "additionalProperties": false, "required": ["id", "text", "start", "end", "speaker"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "start": {"type": ["number", "null"], "minimum": 0}, "end": {"type": ["number", "null"], "minimum": 0}, "speaker": {"type": ["string", "null"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["schema_version", "input_sha256", "input_kind", "provider", "duration_seconds", "processing", "segments"], "properties": {
      "schema_version": {"const": "1.0"}, "input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
      "input_kind": {"enum": ["audio", "text", "summary_only"]}, "provider": {"type": "string", "minLength": 1},
      "duration_seconds": {"type": ["number", "null"], "minimum": 0},
      "processing": {"type": "object", "additionalProperties": false, "required": ["status", "processed_ranges", "failed_ranges", "warnings"], "properties": {
        "status": {"enum": ["partial", "complete"]},
        "processed_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "failed_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }},
      "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
    }}
  }
}
